# ======================
# 一、基础信息与架构配置 (System & Infrastructure)
# ======================

# 后端应用名称 - 用于 FastAPI 生成的 API 文档（Swagger UI）标题
# 代码位置: apps/api/app/main.py (app = FastAPI(title=settings.app_name...))
APP_NAME=Anime Character Analysis API

# 后端应用版本号 - 在 API 文档中标识版本，健康检查接口返回
APP_VERSION=1.0.0

# MySQL 数据库连接字符串（格式: mysql+pymysql://用户名:密码@主机:端口/数据库名）
# 用于连接数据库存储角色、视频和出场时间数据
# 代码位置: apps/api/app/core/database.py (create_engine(settings.database_url...))
DATABASE_URL=mysql+pymysql://root:CHANGE_ME@localhost:3306/anime_tracker

# ======================
# 二、网络跨域与前后端联调 (Network & CORS)
# ======================

# CORS 跨域请求白名单 - 允许前端地址访问后端（端口 5173 是 Vue/Vite 默认端口）
# 防止浏览器同源策略报错（CORS 错误）
# 代码位置: apps/api/app/main.py (CORSMiddleware 配置)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 前端 Vite 构建工具专用环境变量 - 前端发起 API 请求的基础地址
# 告诉 Vue 前端后端服务器运行地址（8000 是 FastAPI 默认端口）
# 代码位置: apps/web/src/... (前端代码中使用)
VITE_API_BASE_URL=http://localhost:8000

# ======================
# 三、AI 识别引擎配置 (AI Recognition Thresholds)
# ======================

# 熟人库识别余弦相似度阈值（0.0-1.0）
# 当人脸特征与库中"已知角色"相似度 >= 0.50 时判定为该角色
# 设定太低易认错人（假阳性），太高会导致认不出来（假阴性）
# 代码位置: apps/api/video_demo.py (FaceRecognizer.recognize() 判定逻辑)
KNOWN_THRESHOLD=0.50

# 陌生人聚类相似度阈值（0.0-1.0）
# 如果不认识该角色，查"陌生人库"：相似度 > 0.55 认为之前见过（如 Stranger_1），将其特征融合
# 如果低于 0.55 则创建全新档案（如 Stranger_2）
# 代码位置: apps/api/video_demo.py (FaceRecognizer 聚类判定)
STRANGER_THRESHOLD=0.55

# ======================
# 四、视频追踪与时间轴优化 (Tracking & Timeline)
# ======================

# 轨迹缓冲帧数（以帧为单位，90帧在 30fps 下约 3 秒）
# 如果角色被遮挡或侧脸导致跟丢，追踪器在内存中保留轨迹 90 帧
# 只要在这 90 帧内重新出现，就继续算作同一个人，防止 ID 频繁跳变
# 代码位置: apps/api/video_demo.py (TrackFeatureAggregator(buffer=TRACK_BUFFER...))
TRACK_BUFFER=90

# 最少出现帧数 - 防抖与抗噪
# 如果 YOLO 检测出人脸但只存在 1~2 帧就消失，认为是"误检"或不可靠闪烁特征，直接丢弃
# 不进行人脸识别，提高识别准确性
# 代码位置: TrackFeatureAggregator 判断条件 if len(t["features"]) >= self.min_frames:
MIN_TRACK_FRAMES=3

# 时间轴最大断层合并帧数
# 生成角色时间轴时，如果角色在第 100 帧消失，110 帧又出现（中间断了不到 15 帧）
# 时间轴生成器会自动合并成一整段，防止前端图表出现无数条细碎竖线
# 代码位置: apps/api/video_demo.py (generate_timeline() 方法)
MAX_GAP_FRAMES=15

# 出场时间最小有效时长（秒）
# 清理碎数据：如果角色在整个视频中连续出场时长加起来都不到 0.5 秒
# 时间轴会将其当成无效片段剔除，不写入数据库，也不展示在前端图表
# 代码位置: apps/api/video_demo.py (generate_timeline() 结尾数据过滤)
MIN_DURATION_SEC=0.5
